<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.mobivault.ui.addmobiles.model.MultiMediaModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimen_100">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/dimen_120"
            android:id="@+id/addIV"
            android:layout_alignParentEnd="true"
            android:foregroundGravity="center"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_height="@dimen/dimen_90"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:src="@drawable/ic_plus"
            />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/imageCv"
            style="@style/card_view_style"
            android:layout_width="@dimen/dimen_100"
            android:layout_height="@dimen/dimen_80"
            android:layout_margin="@dimen/dimen_10"
            android:clickable="false"
            android:layout_marginEnd="@dimen/dimen_10"
            android:padding="@dimen/dimen_0"
             app:layout_constraintStart_toEndOf="@+id/addIV"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imageIv"
                    style="@style/material_card_view_radius"
                    android:layout_width="@dimen/dimen_100"
                    android:layout_height="@dimen/dimen_80"
                    android:background="@color/light_gray"
                    app:loadGlideImage="@{viewModel.path}"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintLeft_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />



            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/dimen_20"
            android:layout_height="@dimen/dimen_20"
            android:id="@+id/cancelIv"
            android:layout_marginLeft="@dimen/dimen_2"
            android:layout_marginTop="@dimen/dimen_2"
            app:layout_constraintEnd_toEndOf="@+id/imageCv"
            android:src="@drawable/cancel_icon"
            android:layout_marginStart="-7dp"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>