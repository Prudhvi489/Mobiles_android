<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/successCv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_20"
            android:layout_marginEnd="@dimen/dimen_20"
            android:background="@color/white"
            android:elevation="@dimen/dimen_5"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/dimen_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="@dimen/dimen_0">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                 android:layout_margin="@dimen/dimen_10">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/cancelIcons"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginBottom="@dimen/dimen_10"
                    android:layout_marginStart="@dimen/dimen_5"
                    android:src="@drawable/cancel_icon"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />





                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/contentTv"
                     android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_5"
                    android:gravity="center"
                     android:lineSpacingExtra="@dimen/dimen_10"
                    android:paddingStart="@dimen/dimen_30"
                    android:paddingEnd="@dimen/dimen_30"
                    android:text=""
                    android:textSize="@dimen/font_17"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelIcon"
                    android:layout_height="wrap_content"
                      android:layout_width="wrap_content"
                     android:layout_marginTop="@dimen/dimen_10"
                    app:cornerRadius="@dimen/dimen_10"
                    android:text="@string/ok"
                     android:visibility="visible"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/contentTv" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>